DATABASE_URL="postgresql://postgres:postgres@staging-db:5432/prediction_game_staging"
PORT=3000
NODE_ENV=production
APP_ENV=staging
PUBLIC_APP_URL="https://stg.example.com"
CORS_ORIGINS="https://stg.example.com,https://stg-admin.example.com,https://*.vercel.app"
AUTH_MODE=jwt_transition
JWT_ISSUER="prediction-game-staging"
JWT_AUDIENCE="prediction-game-clients"
JWT_SECRET="change-me-in-real-env"
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
MONITORING_ENABLED=true
SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
LOG_DIR=logs
