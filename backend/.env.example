DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prediction_game"
PORT=3000
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:8081,http://localhost:3000"
AUTH_MODE=mvp_header
JWT_ISSUER="prediction-game-mvp"
JWT_AUDIENCE="prediction-game-clients"
JWT_SECRET="change-me-in-real-env"
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=prediction_game_refresh
LOG_DIR=logs
MONITORING_ENABLED=false
SENTRY_DSN=""
SENTRY_ENVIRONMENT="local"
